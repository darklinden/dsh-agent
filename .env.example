# ---- DDD endpoint (read by dsh-agent / dsh-blender) ----
DDD_BASE_URL=http://127.0.0.1:18650
DDD_AUTH_TOKEN=                   # secret
DDD_MODEL=
DDD_PROTOCOL=anthropic-messages   # anthropic-messages | openai-completions | openai-responses
DDD_CONTEXT_WINDOW=

# ---- Tavily MCP (read by dsh-agent / dsh-blender) ----
TAVILY_API_KEY=                   # secret

# ---- ccc only (ccc exits when any of these is unset) ----
CCC_BASE_URL=
CCC_AUTH_TOKEN=                   # secret
CCC_MODEL=

# ---- optional switches (defaults apply when commented out) ----
# DSH_CMD_GUARD=on
# DSA_AGENTS_LINK=on
# DSA_WEB_SEARCH=off
# DSH_PI_TUI_PROFILE=pi-tui
# DSH_PI_TUI_PRESET=
# DSH_PI_TUI_RESUME_SESSION=
# DSH_PI_TUI_WORKSPACE_TARGET=
# PHOTOCRAFT_CLI=                 # default <repo>/bin/photocraft-cli
# PHOTOCRAFT_CLI_VERSION=          # default: the latest release tag
# DSH_GUARD_ROOT=                 # default <repo>/bin
# DSH_BLENDER_GUARD_ROOT=         # legacy alias; prefer DSH_GUARD_ROOT
# DSH_JAILBREAK_PLUGIN_SOURCE=    # default github:darklinden/dsh-purge-community
# DSH_JAILBREAK_PLUGIN_PKG=       # default dsh-purge-community
# DSH_PERMISSION_RULES=on         # off launches without the declarative rule patch
# DSH_PERMISSION_RULES_PATCH=     # default <repo>/assets/permission-rules.patch.yml
# DSH_PERMISSION_RULES_SOURCE=    # default <repo>/third-party/dsh-permission-rules
# DSH_PERMISSION_RULES_PKG=       # default @darklinden/dsh-permission-rules
# DSP_MCP_ROOT=
# DSP_HOME_NAME=                  # default dsh-photocraft, under <repo>/dsh-home/
# DSP_AUTOMATION_ROOT=
# DSH_JAILBREAK_HOME_NAME=        # default dsh-jailbreak, under <repo>/dsh-home/

# ---- dsh-sillytavern (optional; defaults apply when commented out) ----
# Imports a SillyTavern AI preset (prompts / prompt_order / temperature /
# maxTokens) into the TUI session. Not a character card or worldbook.
# DSH_SILLYTAVERN_HOME_NAME=dsh-sillytavern
# DSH_SILLYTAVERN_PRESET=/absolute/path/to/sillytavern-preset.json
#                                 # default: assets/sillytavern/preset.json when present
# DSH_SILLYTAVERN_IMPORT=on       # off skips the import and leaves the active preset alone
# DSH_SILLYTAVERN_FORCE_IMPORT=off # on re-imports even when the file hash is unchanged
# DSH_SILLYTAVERN_BOOTSTRAP=on    # off reports a missing pi-tui profile instead of installing it
# DSH_SILLYTAVERN_PLUGIN_SOURCE=  # default <repo>/third-party/dsh-sillytavern-presets
# DSH_SILLYTAVERN_PLUGIN_PKG=dsh-sillytavern-presets
# DSH_SILLYTAVERN_PI_TUI_PKG=@xmoon76/dsh-pi-tui@0.5.6
