#!/usr/bin/env zsh

# dsh-blender [app-args...] — dsh-agent in its own dsh home, with the
# dsh-blender-plugin row installed: the Blender launcher.
#
# A thin front end for `dsh-agent` (see that file for the .env contract, the
# pinned route, telemetry-off, the web_search takeover, the wrong-cmd guard and
# the AGENTS.md link). This script does four things and hands over:
#
#   1. gates on the plugin build and its host links;
#   2. pins the project's dsh-blender.config.json when it exists;
#   3. preserves this home's persisted agent preset by exporting
#      DSH_PI_TUI_PRESET (dsh-agent deliberately does not read it for every
#      home, so dsh-jailbreak/dsh-photocraft keep their current behaviour);
#   4. makes sure the dsh-blender home has the Blender plugin row installed
#      (a symlink to assets/dsh-blender.patch.yml), then execs
#      `dsh-agent dsh-blender`: same argv, one home to the left.
#
# Why a home layer and not an overlay: $DSH_HOME is the single root for
# profiles, sessions, credentials and patch layers, and
# `$DSH_HOME/cordis.patch.yml` is the home-level user layer applied to every
# profile booted in that home. The Blender row therefore belongs to the home
# that exists to carry it, needs no extension point in dsh-agent, and is
# installed exactly once. The link target is tracked in assets/, so editing it
# takes effect on the next launch; a real file written in its place (a user's
# own home layer) is never touched.
#
# Plugin scope: the package is loaded from this checkout by FILE path, never
# installed into a profile. The plugin's own config resolves as
# $DSH_BLENDER_CONFIG → <package root>/dsh-blender.config.json →
# os.homedir()/.dsh/… (os.homedir(), not DSH_HOME); this launcher pins
# $ROOT/dsh-blender.config.json when that file exists, so the project copy
# wins over the global one. .env is re-sourced by dsh-agent, so an entry there
# that defines DSH_BLENDER_CONFIG wins at boot (warned below).
#
# dsh-blender-only environment variables:
#   DSH_BLENDER_GUARD_ROOT  optional. Legacy alias for DSH_GUARD_ROOT; the
#                           generic variable wins when both are set.
#   DSH_BLENDER_CONFIG      optional. Pinned to <repo>/dsh-blender.config.json
#                           when that file exists; see the caveat above.
#
# Everything else is dsh-agent's: DDD_* for the route, DSA_WEB_SEARCH,
# DSH_PI_TUI_PROFILE / _PRESET / _RESUME_SESSION / _WORKSPACE_TARGET,
# DSH_CMD_GUARD and DSH_GUARD_ROOT.
#
# The home is always <repo>/dsh-home/dsh-blender; an inherited $DSH_HOME is
# overwritten by dsh-agent, so it cannot move this launch elsewhere.

BASEDIR=$(dirname "$0")
SCRIPT_DIR="$(realpath "${BASEDIR}")"
ROOT="$(dirname "$SCRIPT_DIR")"

if [ -f "$ROOT/.env" ]; then
    set -a
    source "$ROOT/.env"
    set +a
fi

# Resolve derived paths AFTER .env, matching the old launcher's order: only the
# repo root is needed to find the file, and the plugin/home paths are fixed
# from it rather than read from the file.
DSH_HOME_DIR="$ROOT/dsh-home/dsh-blender"
PLUGIN_DIR="$ROOT/third-party/dsh-blender-plugin"
PLUGIN_ENTRY="$PLUGIN_DIR/lib/index.js"

die() { echo "dsh-blender: $*" >&2; exit 1; }

if ! command -v dsh >/dev/null 2>&1; then
    echo "dsh is not on PATH. Install it first:"
    echo "  npm install -g --allow-scripts=@deepseek-ai/dsh-subprocess-local,koffi,node-pty @deepseek-ai/dsh@latest"
    exit 1
fi
DSH_BIN="$(command -v dsh 2>/dev/null || true)"
[ -z "$DSH_BIN" ] || DSH_BIN="$(realpath "$DSH_BIN")"

# --- Blender plugin gate -----------------------------------------------------
# The home layer names lib/index.js, not the package dir: dsh imports the
# module by file path (a DIRECTORY path is rejected by ESM: "Directory import …
# is not supported"). The package keeps its own build output, so gate on it
# before dsh ever loads the layer.
if [ ! -f "$PLUGIN_ENTRY" ]; then
    echo "dsh-blender-plugin is not built: $PLUGIN_ENTRY is missing." >&2
    echo "  Build it first:" >&2
    echo "    cd \"$PLUGIN_DIR\" && npm ci && npm run build" >&2
    # DSH_CHECKOUT is not a build prerequisite: npm ci already installs
    # @deepseek-ai/dsh-tools into the package's own node_modules. It only makes
    # scripts/build.sh (deprecated) relink the deps out of a dsh source tree, so
    # name the REAL checkout when one resolves — a literal "/path/to/dsh-harness"
    # gets copied into a shell verbatim and dies.
    for candidate in "${DSH_CHECKOUT:-}" "$ROOT/../deepseek-harness" "$ROOT/../dsh-harness" \
                     "$HOME/dsh-harness" "$HOME/dsh"; do
        if [ -n "$candidate" ] && [ -d "$candidate/packages" ]; then
            echo "    # optional, link deps from a local dsh source tree instead:" >&2
            echo "    cd \"$PLUGIN_DIR\" && npm ci && DSH_CHECKOUT=\"$(cd "$candidate" && pwd -P)\" bash scripts/build.sh" >&2
            break
        fi
    done
    exit 1
fi

# lib/index.js statically imports '@deepseek-ai/dsh-tools', and Node resolves
# that from the PLUGIN's own location — so the plugin directory needs its
# node_modules host links. Without them the module fails at import time and the
# whole tree is recycled.
if [ ! -e "$PLUGIN_DIR/node_modules/@deepseek-ai/dsh-tools" ]; then
    DSH_ROOT="$(dirname "$(dirname "$(realpath "$DSH_BIN" 2>/dev/null)" 2>/dev/null)")"
    case "$DSH_ROOT" in ''|.) DSH_ROOT='<dsh 安装根，例如 /usr/local/lib/node_modules/@deepseek-ai/dsh>' ;; esac
    echo "dsh-blender-plugin is missing its host link:" >&2
    echo "  $PLUGIN_DIR/node_modules/@deepseek-ai/dsh-tools" >&2
    echo "  Fix it against the installed dsh (its node_modules carries the host packages):" >&2
    echo "    DSH_ROOT=\"$DSH_ROOT\"   # install root that owns lib/bin.js" >&2
    echo "    mkdir -p \"$PLUGIN_DIR/node_modules/@deepseek-ai\"" >&2
    echo "    ln -s \"\$DSH_ROOT/node_modules/@deepseek-ai/dsh-tools\" \"$PLUGIN_DIR/node_modules/@deepseek-ai/dsh-tools\"" >&2
    echo "  (the other host packages come from build.sh's links; a single link only gets a degraded placeholder tool set)" >&2
    exit 1
fi

# --- legacy guard root -------------------------------------------------------
# DSH_BLENDER_GUARD_ROOT predates the generic DSH_GUARD_ROOT. Keep it working
# without letting it override an explicit generic value; dsh-agent does the
# actual PATH prepend.
if [ -z "${DSH_GUARD_ROOT:-}" ] && [ -n "${DSH_BLENDER_GUARD_ROOT:-}" ]; then
    DSH_GUARD_ROOT="$DSH_BLENDER_GUARD_ROOT"
    export DSH_GUARD_ROOT
fi

# --- persisted agent preset --------------------------------------------------
# dsh-agent resolves --preset > DSH_PI_TUI_PRESET > standard, but it does not
# read the profile's persisted choice for every home: doing that in dsh-agent
# would change dsh-jailbreak/dsh-photocraft too. This launcher has always
# honoured the TUI's own agent-preset-registry.selectedDefault, so read it here
# and hand it to dsh-agent as the environment default. An explicit --preset
# still wins inside dsh-agent, and .env is re-sourced there, so a
# DSH_PI_TUI_PRESET entry in .env keeps winning over this value.
PROFILE="${DSH_PI_TUI_PROFILE:-pi-tui}"
persisted_preset() {
    [ -f "$1" ] || return 0
    awk '
        /^[[:space:]]*-[[:space:]]*id:[[:space:]]*agent-preset-registry[[:space:]]*$/ { row = 1; next }
        row && /^[[:space:]]*-[[:space:]]*id:[[:space:]]*/ { row = 0 }
        row && /^[[:space:]]+selectedDefault[[:space:]]*:/ {
            line = $0
            sub(/^[^:]*:[[:space:]]*/, "", line)
            gsub(/["[:space:]]/, "", line)
            if (line != "") { print line; exit }
        }
    ' "$1"
}
# dsh-agent only derives/pins the preset when the built-in web_search takeover
# is active. Mirror that switch: an unknown value is treated as off by
# dsh-agent, so this case does the same.
case "${DSA_WEB_SEARCH:-off}" in
    on) ;;
    *)
        if [ -z "${DSH_PI_TUI_PRESET:-}" ]; then
            persisted="$(persisted_preset "$DSH_HOME_DIR/profiles/$PROFILE/cordis.patch.yml")"
            if [ -n "$persisted" ]; then
                DSH_PI_TUI_PRESET="$persisted"
                export DSH_PI_TUI_PRESET
            fi
        fi
        ;;
esac

# --- project plugin config ---------------------------------------------------
# The plugin resolves its own config as $DSH_BLENDER_CONFIG → <package root>/
# dsh-blender.config.json → os.homedir()/.dsh/dsh-blender.config.json. That last
# candidate is the GLOBAL home (the plugin reads os.homedir(), not DSH_HOME), so
# a project copy dropped next to this home would be ignored while the global file
# keeps leaking in. Pin the project copy whenever one exists.
if [ -f "$ROOT/dsh-blender.config.json" ]; then
    # dsh-agent re-sources .env after this export; an entry there would win.
    # Say so rather than letting the pin look effective when it is not.
    if [ -f "$ROOT/.env" ] \
       && grep -qE '^[[:space:]]*(export[[:space:]]+)?DSH_BLENDER_CONFIG=' "$ROOT/.env" \
       && [ "${DSH_BLENDER_CONFIG:-}" != "$ROOT/dsh-blender.config.json" ]; then
        echo "Warning: $ROOT/.env defines DSH_BLENDER_CONFIG; dsh-agent re-sources it, so that value wins over the project copy." >&2
    fi
    DSH_BLENDER_CONFIG="$ROOT/dsh-blender.config.json"
    export DSH_BLENDER_CONFIG
fi

# --- home layer: the Blender plugin row --------------------------------------
# Install once. A dangling link is NOT "installed": dsh's loader treats the
# missing file as no overlay at all, so the tools would vanish silently. It is
# repaired on launch. A real file (or a link to somewhere else) is never
# repointed — it may be the user's own home layer — only reported.
PATCH_SRC="$ROOT/assets/dsh-blender.patch.yml"
HOME_PATCH="$DSH_HOME_DIR/cordis.patch.yml"
PATCH_STATE=present
if [ ! -e "$PATCH_SRC" ]; then
    PATCH_STATE=no-src
elif [ -L "$HOME_PATCH" ] && [ -e "$HOME_PATCH" ] \
     && [ "$(realpath "$HOME_PATCH" 2>/dev/null)" = "$(realpath "$PATCH_SRC" 2>/dev/null)" ]; then
    PATCH_STATE=present
elif [ ! -e "$HOME_PATCH" ] && [ ! -L "$HOME_PATCH" ]; then
    if mkdir -p "$DSH_HOME_DIR" && ln -s "$PATCH_SRC" "$HOME_PATCH"; then
        PATCH_STATE=installed
    else
        PATCH_STATE=missing
    fi
elif [ -L "$HOME_PATCH" ] && [ ! -e "$HOME_PATCH" ]; then
    # Dangling: the target is gone (a moved checkout). Replace the link
    # atomically rather than leaving the session without the plugin row.
    patch_tmp="$DSH_HOME_DIR/.cordis.patch.yml.dsh-link.$$.${RANDOM}"
    if ln -s "$PATCH_SRC" "$patch_tmp" 2>/dev/null && mv -f "$patch_tmp" "$HOME_PATCH"; then
        PATCH_STATE=repaired
    else
        PATCH_STATE=missing
    fi
else
    PATCH_STATE=foreign
fi

case "$PATCH_STATE" in
    installed) echo "Blender: home layer installed -> $HOME_PATCH" ;;
    repaired)  echo "Blender: home layer repaired -> $HOME_PATCH" ;;
    present)   echo "Blender: home layer present -> $HOME_PATCH" ;;
    foreign)   echo "Blender: WARNING — $HOME_PATCH is not this launcher's layer; unless it carries the Blender plugin row, this session has no Blender tools." >&2 ;;
    no-src)    die "$PATCH_SRC is missing; cannot install the Blender plugin row." ;;
    missing)   die "could not create $HOME_PATCH; the session would have no Blender tools." ;;
esac

echo "Blender: plugin $PLUGIN_ENTRY"
echo "Blender: home $DSH_HOME_DIR (profile $PROFILE)"
exec "$SCRIPT_DIR/dsh-agent" dsh-blender "$@"
